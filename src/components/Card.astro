---
const { title, href } = Astro.props as { title: string; href?: string };
---

<article class="card">
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <slot />
</article>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-5);
    position: relative;
  }
  .card h3 {
    font-size: var(--step-1);
  }
  .card h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* Whole card is clickable via the title link, without nesting interactive content. */
  .card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:has(h3 a:hover) {
    border-color: var(--color-brand);
  }
  .card :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
